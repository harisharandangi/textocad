# Any one provider key is enough. Provider is detected from the key if unset:
# openai, anthropic, gemini, xai, deepseek, openrouter, mistral, groq, together, fireworks
TEXTOCAD_API_KEY=
TEXTOCAD_PROVIDER=
TEXTOCAD_MODEL=

# Or run on the built-in DeepSeek engine
DEEPSEEK_API_KEY=

# Seconds one generation may take, end to end
GENERATION_BUDGET_SECONDS=420

# Memory cap for the build subprocess, in MB (0 = no cap)
TEXTOCAD_SANDBOX_MEM_MB=4096

# Folder for the BOSL2 OpenSCAD library (default ~/.textocad/openscad)
TEXTOCAD_LIB_DIR=
